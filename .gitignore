# Windows reserved device names accidentally created by shell redirects
# (e.g. `... 2>nul` run from PowerShell). A file literally named `nul` also
# breaks ripgrep and other tools that walk the tree.
nul

# Commit messages are written to a temp file and passed to `git commit -F`,
# because PowerShell has no heredoc and multi-line `-m` is unreliable there.
.commitmsg.tmp

# Optional local sound pack for examples/10-arpg. The demo synthesizes its cues
# (examples/10-arpg/sfx.ts) and only substitutes files named in
# public/sfx/arpg-cues.json, so nothing here is required to run it — and no
# third-party audio ends up committed by accident.
public/sfx/arpg/



