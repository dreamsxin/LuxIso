{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "dist"
  },
  "include": [
    "src",
    "webgl-next/src",
    "webgl-next/main.ts",
    "webgl-next/e2e",
    "examples",
    "vite.config.ts",
    "playwright.webgl.config.ts"
  ]
}
